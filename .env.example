# Copie este arquivo para ".env" e preencha com valores reais.
# NUNCA commitar o .env de verdade — ele já está no .gitignore.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=troque-por-uma-chave-secreta-gerada-com-get_random_secret_key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,estoque.locuslocacoes.com.br
DJANGO_CSRF_TRUSTED_ORIGINS=https://estoque.locuslocacoes.com.br
DJANGO_SECURE_COOKIES=False
DJANGO_SECURE_SSL_REDIRECT=True

# URL permanente para os QR Codes (especificação, seção 14/22)
SITE_BASE_URL=https://estoque.locuslocacoes.com.br

# Links comerciais da landing pública do QR (etapa de UX/UI, 28/08/2026).
# Vazios = o CTA correspondente simplesmente não aparece na landing —
# preencha com as URLs reais da Locus antes de considerar a landing
# pronta para uso comercial.
LOCUS_INSTAGRAM_URL=
LOCUS_SITE_URL=
LOCUS_WHATSAPP_URL=https://wa.me/5544991128051
LOCUS_ORCAMENTO_URL=
LOCUS_EQUIPAMENTOS_URL=

DB_NAME=locus_equipamentos
DB_USER=locus
DB_PASSWORD=troque-por-uma-senha-forte
DB_HOST=db
DB_PORT=5432

# Proteção contra força bruta no login (django-axes, especificação seção 11).
# Ajuste conforme a política de segurança da Locus.
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=30
